# Python 缓存
__pycache__/
*.py[cod]
*.pyo

# 虚拟环境（换机器后请重新 pip install -r requirements.txt）
venv/
.venv/
env/
ENV/

# 运行日志
*.log
nohup.out

# 运行时导出文件
web_app/exports/*
!web_app/exports/.gitkeep

# 本地数据库配置（含口令，禁止上传公开仓库）
.env
*.cnf

# 编辑器与系统临时文件
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
~$*

# WorkBuddy 会话与记忆目录（不属于项目内容）
.workbuddy/
memory/
